type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserProfileInput = 
 record {
   email: text;
   fullName: text;
 };
type UserProfile = 
 record {
   createdAt: Timestamp;
   email: text;
   fullName: text;
   id: UserId;
 };
type UserId = principal;
type Timestamp = int;
type ShiftJobId = nat;
type ShiftJob = 
 record {
   company: text;
   createdAt: int;
   description: text;
   id: ShiftJobId;
   isActive: bool;
   jobRole: text;
   location: text;
   shiftEnd: text;
   shiftStart: text;
   shiftType: text;
 };
type Result = 
 variant {
   err: Error;
   ok;
 };
type NewShiftJob = 
 record {
   company: text;
   description: text;
   jobRole: text;
   location: text;
   shiftEnd: text;
   shiftStart: text;
   shiftType: text;
 };
type InterviewId = nat;
type Interview = 
 record {
   company: text;
   createdAt: Timestamp;
   date: text;
   description: text;
   id: InterviewId;
   isActive: bool;
   jobRole: text;
   location: text;
   time: text;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type ApplicationInput = 
 record {
   email: text;
   interviewId: opt InterviewId;
   message: text;
   name: text;
   phone: text;
   qualification: text;
   skills: text;
 };
type ApplicationId = nat;
type Application = 
 record {
   appliedAt: Timestamp;
   email: text;
   id: ApplicationId;
   interviewId: opt InterviewId;
   message: text;
   name: text;
   phone: text;
   qualification: text;
   skills: text;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result);
  _internet_identity_sign_in_start: () -> (blob);
  addShiftJob: (input: NewShiftJob) -> (ShiftJob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  getActiveInterviews: () -> (vec Interview) query;
  getAllApplications: () -> (vec Application) query;
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCallerUserRole: () -> (UserRole) query;
  getInterview: (id: InterviewId) -> (opt Interview) query;
  getShiftJobs: () -> (vec ShiftJob) query;
  getUserProfile: (user: principal) -> (opt UserProfile) query;
  isCallerAdmin: () -> (bool) query;
  saveCallerUserProfile: (profile: UserProfileInput) ->
   (variant {
      err: text;
      ok: UserProfile;
    });
  submitApplication: (input: ApplicationInput) ->
   (variant {
      err: text;
      ok: text;
    });
}
